    {
        "id": "ab92b885bed15afe",
        "type": "function",
        "z": "a3416d428f34cb7d",
        "name": "TVON - status",
        "func": "if (msg.payload.code == 0){\n    let TV_state = flow.get(\"TV_state\") || {}\n    TV_state.status = \"online\"\n    flow.set(\"TV_state\",TV_state)\n    node.status({\n        fill:\"green\",\n        shape:\"dot\",\n        text:\"TV ON\"\n    })\n} else {\n    flow.set(\"TV_state\", {\"state\":\"offline\"})\n    node.status({\n        fill: \"grey\",\n        shape: \"ring\",\n        text: \"unknown\"\n    })\n}\nvar response = null;\nif(msg.request){\n    response = {payload: 0};\n}\nreturn [msg, response];",
        "outputs": 0,
