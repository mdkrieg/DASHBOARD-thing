    {
        "id": "weather-request",
        "type": "http request",
        "z": "a3e21b69d66e5ed8",
        "name": "Open-Meteo Current",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.open-meteo.com/v1/forecast?latitude=41.85&longitude=-87.65&current=temperature_2m,relative_humidity_2m,precipitation_probability,cloud_cover,wind_speed_10m,surface_pressure,uv_index&wind_speed_unit=mph&temperature_unit=fahrenheit&precipitation_unit=inch",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 410,
        "y": 200,
        "wires": [
            [
                "weather-parse"
            ]
        ]
    },
    {
        "id": "weather-parse",
        "type": "function",
        "z": "a3e21b69d66e5ed8",
        "name": "Parse Current Weather",
        "func": "const c = msg.payload.current;\nif (!c) { node.warn('No current data in weather response'); return null; }\nflow.set('weather', {\n    temperature: c.temperature_2m,\n    humidity: c.relative_humidity_2m,\n    precipitation_probability: c.precipitation_probability,\n    cloud_cover: c.cloud_cover,\n    wind_speed: c.wind_speed_10m,\n    pressure: c.surface_pressure,\n    uv_index: c.uv_index,\n    updated: new Date().toLocaleTimeString()\n});\nreturn msg;",
        "outputs": 1,
        "x": 650,
        "y": 200,
        "wires": [
            []
        ]
    },
    {
        "id": "forecast-request",
        "type": "http request",
        "z": "a3e21b69d66e5ed8",
        "name": "Open-Meteo Forecast",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.open-meteo.com/v1/forecast?latitude=41.85&longitude=-87.65&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max,surface_pressure_mean&wind_speed_unit=mph&temperature_unit=fahrenheit&precipitation_unit=inch&timezone=America%2FChicago",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 410,
        "y": 260,
        "wires": [
            [
                "forecast-parse"
            ]
        ]
    },
    {
        "id": "forecast-parse",
        "type": "function",
        "z": "a3e21b69d66e5ed8",
        "name": "Parse Forecast",
        "func": "const d = msg.payload.daily;\nif (!d) { node.warn('No daily data in forecast response'); return null; }\nconst days = d.time.map((date, i) => ({\n    date,\n    temp_max: d.temperature_2m_max[i],\n    temp_min: d.temperature_2m_min[i],\n    precip_prob: d.precipitation_probability_max[i],\n    wind_max: d.wind_speed_10m_max[i],\n    pressure_mean: d.surface_pressure_mean[i]\n}));\nflow.set('forecast', { days, updated: new Date().toLocaleTimeString() });\nreturn msg;",
        "outputs": 1,
        "x": 650,
        "y": 260,
        "wires": [
            []
        ]
    },
    {
        "id": "aqi-request",
        "type": "http request",
        "z": "a3e21b69d66e5ed8",
        "name": "Open-Meteo AQI",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=41.85&longitude=-87.65&current=us_aqi,pm2_5",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 410,
        "y": 320,
        "wires": [
            [
                "aqi-parse"
            ]
        ]
    },
    {
        "id": "aqi-parse",
        "type": "function",
        "z": "a3e21b69d66e5ed8",
        "name": "Parse AQI",
        "func": "const c = msg.payload.current;\nif (!c) { node.warn('No current data in AQI response'); return null; }\nflow.set('aqi', {\n    us_aqi: c.us_aqi,\n    pm2_5: c.pm2_5,\n    updated: new Date().toLocaleTimeString()\n});\nreturn msg;",
        "outputs": 1,
        "x": 650,
        "y": 320,
        "wires": [
            []
        ]
    },
