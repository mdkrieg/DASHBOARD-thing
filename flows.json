    {
        "id": "weather-request",
        "type": "http request",
        "z": "a3e21b69d66e5ed8",
        "name": "Open-Meteo Current",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "query",
        "url": "https://api.open-meteo.com/v1/forecast?current=temperature_2m,relative_humidity_2m,precipitation_probability,cloud_cover,wind_speed_10m,surface_pressure,uv_index&wind_speed_unit=mph&temperature_unit=fahrenheit&precipitation_unit=inch",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 440,
        "y": 220,
        "wires": [
            [
                "weather-parse"
            ]
        ]
    },
    {
        "id": "weather-parse",
        "type": "function",
        "z": "a3e21b69d66e5ed8",
        "name": "Parse Current Weather",
        "func": "const c = msg.payload.current;\nif (!c) { node.warn('No current data in weather response'); return null; }\nflow.set('weather', {\n    temperature: c.temperature_2m,\n    humidity: c.relative_humidity_2m,\n    precipitation_probability: c.precipitation_probability,\n    cloud_cover: c.cloud_cover,\n    wind_speed: c.wind_speed_10m,\n    pressure: c.surface_pressure,\n    uv_index: c.uv_index,\n    updated: new Date().toLocaleTimeString()\n});\nreturn msg;",
        "outputs": 1,
        "x": 780,
        "y": 220,
        "wires": [
            []
        ]
    },
    {
        "id": "forecast-request",
        "type": "http request",
        "z": "a3e21b69d66e5ed8",
        "name": "Open-Meteo Forecast",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "query",
        "url": "https://api.open-meteo.com/v1/forecast?daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max,surface_pressure_mean&hourly=temperature_2m,precipitation_probability&wind_speed_unit=mph&temperature_unit=fahrenheit&precipitation_unit=inch&timezone=America%2FChicago",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 440,
        "y": 280,
        "wires": [
            [
                "forecast-parse"
            ]
        ]
    },
    {
        "id": "forecast-parse",
        "type": "function",
        "z": "a3e21b69d66e5ed8",
        "name": "Parse Forecast",
        "func": "const d = msg.payload.daily;\nconst h = msg.payload.hourly;\nif (!d) { node.warn('No daily data in forecast response'); return null; }\nconst days = d.time.map((date, i) => {\n    let hourlyData = null;\n    if (h && h.time) {\n        const prefix = date + 'T';\n        const start = h.time.findIndex(t => t.startsWith(prefix));\n        if (start >= 0) {\n            hourlyData = {\n                temperature: h.temperature_2m.slice(start, start + 24),\n                precip_prob: h.precipitation_probability.slice(start, start + 24)\n            };\n        }\n    }\n    return {\n        date,\n        temp_max: d.temperature_2m_max[i],\n        temp_min: d.temperature_2m_min[i],\n        precip_prob: d.precipitation_probability_max[i],\n        wind_max: d.wind_speed_10m_max[i],\n        pressure_mean: d.surface_pressure_mean[i],\n        hourly: hourlyData\n    };\n});\nflow.set('forecast', { days, updated: new Date().toLocaleTimeString() });\nreturn msg;",
        "outputs": 1,
        "x": 780,
        "y": 280,
        "wires": [
            []
        ]
    },
